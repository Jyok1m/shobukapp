# Copy to .env.local and fill in. Git-ignored. Read by the Makefile only, which
# sources it in the recipe's shell: quote a value with a space, # or $, but
# leave a path starting with ~ unquoted so it expands.

SSH_HOST=
SSH_PORT=
SSH_USER=debian
SSH_KEY_FILE=

# Dev Postgres, published on the server loopback. DATABASE_URL in
# apps/api/.env targets the local port: both must agree.
PG_DEV_LOCAL_PORT=15433
PG_DEV_REMOTE_PORT=15433

# If the SSH user is not in the docker group on the server: REMOTE_DOCKER="sudo docker"
REMOTE_DOCKER=
