// Conventions and model rationale: docs/database.md.
// The connection URL lives in prisma.config.ts (CLI) and in PrismaService (runtime).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PRACTITIONER
  ADMIN
}

enum Sex {
  FEMALE
  MALE
}

// How often a cotisation is paid. QUARTER is a Stripe price every 3 months.
enum PlanInterval {
  MONTH
  QUARTER
  YEAR
}

enum PaymentStatus {
  PAID
  FAILED
  OPEN
}

enum DocumentCategory {
  MEDICAL_CERTIFICATE
  LEGAL
  RULES
  ACCOUNTING
  OTHER
}

// Where a dojo document shows on the members' dashboard. PRIVATE: admins only.
enum DocumentPlacement {
  PRIVATE
  ANNOUNCEMENT
  IMPORTANT
}

enum ReminderChannel {
  EMAIL
}

enum JoinRequestStatus {
  NEW
  INVITED
  DECLINED
}

// LINK: sent in answer to a join request. CODE: typed by an existing
// practitioner who has no account yet (docs/onboarding.md).
enum InvitationKind {
  LINK
  CODE
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  Role      @default(PRACTITIONER)
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  phone                 String?
  photoKey              String?   @map("photo_key")
  birthDate             DateTime? @map("birth_date") @db.Date
  sex                   Sex?
  nationality           String?
  addressLine           String?   @map("address_line")
  postalCode            String?   @map("postal_code")
  city                  String?
  country               String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  directoryVisible      Boolean   @default(false) @map("directory_visible")
  // One Stripe customer per mode: test and live objects never cross.
  stripeTestCustomerId  String?   @unique @map("stripe_test_customer_id")
  stripeLiveCustomerId  String?   @unique @map("stripe_live_customer_id")
  // Null for an account an admin created: accepted at first login.
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  // Set when an admin chose the password: every route but the password change
  // answers 403 until the member picks their own (docs/members.md).
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  subscriptions       Subscription[]
  payments            Payment[]
  remindersReceived   PaymentReminder[] @relation("ReminderTarget")
  remindersSent       PaymentReminder[] @relation("ReminderAuthor")
  documents           Document[]        @relation("DocumentOwner")
  documentsUploaded   Document[]        @relation("DocumentUploader")
  licenses            License[]         @relation("LicenseOwner")
  licensesUploaded    License[]         @relation("LicenseUploader")
  messagesSent        Message[]         @relation("MessageSender")
  messagesReceived    Message[]         @relation("MessageRecipient")
  exports             MemberExport[]
  invitationsSent     Invitation[]      @relation("InvitationAuthor")
  invitationUsed      Invitation?       @relation("InvitationUser")
  joinRequestsHandled JoinRequest[]
  roleChanges         RoleChange[]      @relation("RoleChangeTarget")
  roleChangesMade     RoleChange[]      @relation("RoleChangeAuthor")
  settingsChanged     AppSettings[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Plan {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  currency            String   @default("eur")
  // One Stripe product per mode; each frequency is a price under it.
  stripeTestProductId String?  @unique @map("stripe_test_product_id")
  stripeLiveProductId String?  @unique @map("stripe_live_product_id")
  active              Boolean  @default(true)
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  prices        PlanPrice[]

  @@map("plans")
}

// One row per frequency a cotisation offers (docs/billing.md, Frequencies).
model PlanPrice {
  id                String       @id @default(uuid()) @db.Uuid
  planId            String       @map("plan_id") @db.Uuid
  frequency         PlanInterval
  amountCents       Int          @map("amount_cents")
  active            Boolean      @default(true)
  stripeTestPriceId String?      @unique @map("stripe_test_price_id")
  stripeLivePriceId String?      @unique @map("stripe_live_price_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, frequency])
  @@map("plan_prices")
}

model Subscription {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  planId               String?       @map("plan_id") @db.Uuid
  stripeSubscriptionId String        @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime?     @map("current_period_end")
  cancelAtPeriodEnd    Boolean       @default(false) @map("cancel_at_period_end")
  frequency            PlanInterval?
  livemode             Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  stripeInvoiceId String        @unique @map("stripe_invoice_id")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("eur")
  status          PaymentStatus
  paidAt          DateTime?     @map("paid_at")
  livemode        Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("stripe_events")
}

model PaymentReminder {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  sentById  String?         @map("sent_by_id") @db.Uuid
  channel   ReminderChannel @default(EMAIL)
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")

  user   User  @relation("ReminderTarget", fields: [userId], references: [id], onDelete: Cascade)
  sentBy User? @relation("ReminderAuthor", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payment_reminders")
}

model Document {
  id           String            @id @default(uuid()) @db.Uuid
  ownerId      String?           @map("owner_id") @db.Uuid
  category     DocumentCategory
  title        String
  storageKey   String            @unique @map("storage_key")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  validUntil   DateTime?         @map("valid_until") @db.Date
  // Dojo documents only (owner_id null): member documents are never published.
  placement    DocumentPlacement @default(PRIVATE)
  description  String?
  publishedAt  DateTime?         @map("published_at")
  uploadedById String?           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  owner      User? @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("documents")
}

model License {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  season       String
  number       String
  storageKey   String?  @unique @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User  @relation("LicenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("LicenseUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([userId, season])
  @@map("licenses")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model MemberExport {
  id           String   @id @default(uuid()) @db.Uuid
  exportedById String?  @map("exported_by_id") @db.Uuid
  rowCount     Int      @map("row_count")
  createdAt    DateTime @default(now()) @map("created_at")

  exportedBy User? @relation(fields: [exportedById], references: [id], onDelete: SetNull)

  @@map("member_exports")
}

model JoinRequest {
  id          String            @id @default(uuid()) @db.Uuid
  firstName   String            @map("first_name")
  lastName    String            @map("last_name")
  email       String
  phone       String?
  message     String
  wantsTrial  Boolean           @map("wants_trial")
  status      JoinRequestStatus @default(NEW)
  handledById String?           @map("handled_by_id") @db.Uuid
  handledAt   DateTime?         @map("handled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  handledBy  User?       @relation(fields: [handledById], references: [id], onDelete: SetNull)
  invitation Invitation?

  @@index([status, createdAt])
  @@map("join_requests")
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  kind           InvitationKind
  email          String
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  tokenHash      String         @unique @map("token_hash")
  expiresAt      DateTime       @map("expires_at")
  failedAttempts Int            @default(0) @map("failed_attempts")
  usedAt         DateTime?      @map("used_at")
  revokedAt      DateTime?      @map("revoked_at")
  usedById       String?        @unique @map("used_by_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  joinRequestId  String?        @unique @map("join_request_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  usedBy      User?        @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("InvitationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  joinRequest JoinRequest? @relation(fields: [joinRequestId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invitations")
}

model RoleChange {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  changedById String?  @map("changed_by_id") @db.Uuid
  fromRole    Role     @map("from_role")
  toRole      Role     @map("to_role")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("RoleChangeTarget", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User? @relation("RoleChangeAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("role_changes")
}

// A single row (id 1): settings an admin switches at runtime.
model AppSettings {
  id          Int      @id @default(1)
  stripeLive  Boolean  @default(false) @map("stripe_live")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
