// Conventions and model rationale: docs/database.md.
// The connection URL lives in prisma.config.ts (CLI) and in PrismaService (runtime).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PRACTITIONER
  ADMIN
}

enum Sex {
  FEMALE
  MALE
}

enum PlanInterval {
  MONTH
  YEAR
}

enum PaymentStatus {
  PAID
  FAILED
  OPEN
}

enum DocumentCategory {
  MEDICAL_CERTIFICATE
  LEGAL
  ACCOUNTING
  OTHER
}

enum ReminderChannel {
  EMAIL
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  Role      @default(PRACTITIONER)
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  phone                 String?
  photoKey              String?   @map("photo_key")
  birthDate             DateTime? @map("birth_date") @db.Date
  sex                   Sex?
  nationality           String?
  addressLine           String?   @map("address_line")
  postalCode            String?   @map("postal_code")
  city                  String?
  country               String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  directoryVisible      Boolean   @default(false) @map("directory_visible")
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  termsAcceptedAt       DateTime  @map("terms_accepted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  subscriptions     Subscription[]
  payments          Payment[]
  remindersReceived PaymentReminder[] @relation("ReminderTarget")
  remindersSent     PaymentReminder[] @relation("ReminderAuthor")
  documents         Document[]        @relation("DocumentOwner")
  documentsUploaded Document[]        @relation("DocumentUploader")
  licenses          License[]         @relation("LicenseOwner")
  licensesUploaded  License[]         @relation("LicenseUploader")
  messagesSent      Message[]         @relation("MessageSender")
  messagesReceived  Message[]         @relation("MessageRecipient")
  exports           MemberExport[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Plan {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  amountCents     Int          @map("amount_cents")
  currency        String       @default("eur")
  interval        PlanInterval
  stripeProductId String?      @unique @map("stripe_product_id")
  stripePriceId   String?      @unique @map("stripe_price_id")
  active          Boolean      @default(true)
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  planId               String?   @map("plan_id") @db.Uuid
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  stripeInvoiceId String        @unique @map("stripe_invoice_id")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("eur")
  status          PaymentStatus
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("stripe_events")
}

model PaymentReminder {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  sentById  String?         @map("sent_by_id") @db.Uuid
  channel   ReminderChannel @default(EMAIL)
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")

  user   User  @relation("ReminderTarget", fields: [userId], references: [id], onDelete: Cascade)
  sentBy User? @relation("ReminderAuthor", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payment_reminders")
}

model Document {
  id           String           @id @default(uuid()) @db.Uuid
  ownerId      String?          @map("owner_id") @db.Uuid
  category     DocumentCategory
  title        String
  storageKey   String           @unique @map("storage_key")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  validUntil   DateTime?        @map("valid_until") @db.Date
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  owner      User? @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("documents")
}

model License {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  season       String
  number       String
  storageKey   String?  @unique @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User  @relation("LicenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("LicenseUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([userId, season])
  @@map("licenses")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model MemberExport {
  id           String   @id @default(uuid()) @db.Uuid
  exportedById String?  @map("exported_by_id") @db.Uuid
  rowCount     Int      @map("row_count")
  createdAt    DateTime @default(now()) @map("created_at")

  exportedBy User? @relation(fields: [exportedById], references: [id], onDelete: SetNull)

  @@map("member_exports")
}
