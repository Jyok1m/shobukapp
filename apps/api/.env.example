PORT=3001
# development | staging | production (decides the allowed Stripe key mode)
APP_ENV=development
WEB_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shobukapp?schema=public"
SESSION_TTL_DAYS=30

# Stripe (test mode outside production)
STRIPE_SECRET_KEY=
# Printed by: stripe listen --forward-to localhost:3001/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Local file storage, git-ignored
STORAGE_DIR=./storage

# Optional: without it, emails are logged instead of sent
SMTP_URL=
MAIL_FROM="Shobukan Dojo <no-reply@shobukan-dojo.com>"
