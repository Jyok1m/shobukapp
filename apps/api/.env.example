PORT=3001
# development | staging | production (decides the allowed Stripe key mode)
APP_ENV=development
WEB_URL=http://localhost:3000

# Dev database on the server through `make tunnel` (see .env.local.example at the root).
DATABASE_URL="postgresql://shobukapp:<dev password, url-encoded>@localhost:15433/shobukapp?schema=public"
# Local Docker Postgres for migrations being written, the seed and the e2e suites.
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shobukapp?schema=public"
SESSION_TTL_DAYS=30

# Stripe, one pair per mode; the admin switch (/admin/cotisations) picks the
# serving one. Live keys are refused outside APP_ENV=production.
STRIPE_TEST_SECRET_KEY=
# Printed by: stripe listen --forward-to localhost:3001/billing/webhook
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Local file storage, git-ignored
STORAGE_DIR=./storage

# Optional: without SMTP_HOST, emails are logged instead of sent.
# Production: mailcow submission port with STARTTLS, the address is the username.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender must be the authenticated mailbox, or mailcow refuses it.
MAIL_FROM="Shobukan Dojo <no-reply@joachimjasmin.com>"
